# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/athena?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=<your-super-secret-jwt-key-change-this-in-production>
JWT_EXPIRE=7d

# Frontend URL (for CORS)
FRONTEND_URL=https://your-vercel-app.vercel.app

# Admin Account (for seeding - production only)
ADMIN_EMAIL=<admin-email>
ADMIN_PASSWORD=<strong-password>
ADMIN_NAME=<admin-name>

# Coach Account (for seeding - production only)
COACH_EMAIL=<coach-email>
COACH_PASSWORD=<strong-password>
COACH_NAME=<coach-name>

# Athlete Account (for seeding - production only)
ATHLETE_EMAIL=<athlete-email>
ATHLETE_PASSWORD=<strong-password>
ATHLETE_NAME=<athlete-name>
